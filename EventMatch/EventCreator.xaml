<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EventMatch.EventCreator"
             BackgroundImageSource="download_p.jpg"
             Shell.NavBarIsVisible="False">
    
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Create Event" FontSize="20" TextColor="White" HorizontalOptions="Start"
            Margin="0,8,0,0"
            FontFamily="Poppins" FontAttributes="Bold" />
            <!-- Tall rectangle where images will later be loaded -->
            <Frame HasShadow="False" CornerRadius="8" BackgroundColor="#333333" HeightRequest="420" HorizontalOptions="Fill" VerticalOptions="Start">
                <Grid>
                    <Image x:Name="EventImage" Source="image-placeholder.png" Aspect="AspectFill" />
                    <!-- Optional overlay text to indicate this is the image area -->
                    <Label x:Name="ImageOverlayLabel" Text="Tap to pick image" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#CCCCCC" Opacity="0.8"/>
                    <Button x:Name="PickImageButton" Text="Pick Image" BackgroundColor="#80000000" TextColor="White" CornerRadius="6" HorizontalOptions="End" VerticalOptions="End" Margin="12" Clicked="OnPickImageClicked" />
                </Grid>
            </Frame>

            <!-- Small label above the details textbox -->
            <Label Text="Event discription" FontSize="12" TextColor="#D8BFD8" />

            <!-- Multiline textbox for event details -->
            <Editor x:Name="EventDetailsEditor" AutoSize="TextChanges" HeightRequest="120" BackgroundColor="#80232323" TextColor="White" />

            <Label x:Name="LocationLabel"
       Text="No location selected"
       TextColor="White"
       FontSize="13"
       Margin="0,4,0,0"/>

            <!-- Tags input section -->
            <Label Text="Tags (e.g., #music, #sports)" FontSize="12" TextColor="#D8BFD8" />
            <Entry x:Name="TagsEntry" 
                   Placeholder="Enter tags separated by commas" 
                   PlaceholderColor="#888888"
                   BackgroundColor="#80232323" 
                   TextColor="White"
                   HeightRequest="40" />

            <!-- Date & Time pickers -->
            <HorizontalStackLayout Spacing="12" VerticalOptions="Center" HorizontalOptions="Fill">
                <DatePicker x:Name="EventDatePicker" 
                            TextColor="White"/>
                <TimePicker x:Name="EventTimePicker" 
                            TextColor="White"/>
            </HorizontalStackLayout>

            <!-- Buttons row -->
            <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                <Button Text="Pick Location"
            BackgroundColor="#5B21B6"
            TextColor="White"
            CornerRadius="8"
            Clicked="OnPickLocationClicked"/>

                <Button Text="Save"
            BackgroundColor="#2E8B57"
            TextColor="White"
            CornerRadius="8"
            HeightRequest="48"
            WidthRequest="110"
            Clicked="OnSaveClicked"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
