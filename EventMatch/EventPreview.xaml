<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EventMatch.EventPreview"
             Title="ReviewEvents"
             BackgroundColor="#121212">

    <Grid>
        <Label Text="Event Preview" FontSize="20" TextColor="White" HorizontalOptions="Center" />
        <Image x:Name="EventImage"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Start"
               HeightRequest="350"/>

        <Border StrokeThickness="0"
                VerticalOptions="End"
                HeightRequest="400"
                StrokeShape="RoundRectangle 25,25,0,0"
                Padding="0">
            <Grid>
                <!-- FONAS -->
                <Image Source="download_p.jpg" Aspect="AspectFill"/>
                <!-- TAMSUS OVERLAY -->
                <BoxView BackgroundColor="#80232323"/>

                <!-- TURINYS -->
                <StackLayout Padding="20" Spacing="10">
                    <Label x:Name="NoEventsLabel"
                           Text="No events at the moment"
                           FontSize="16"
                           TextColor="White"
                           HorizontalOptions="Center"
                           IsVisible="False"/>

                    <Label Text="Event"
                           FontSize="20"
                           TextColor="White"
                           FontAttributes="Bold"/>

                    <Label x:Name="EventDetailsLabel"
                           TextColor="White"
                           FontSize="14"/>

                    <Label x:Name="LocationLabel"
                           TextColor="#D8BFD8"
                           FontSize="13"
                           IsVisible="False"/>

                    <Label x:Name="TagsLabel"
                           TextColor="#A259FF"
                           FontSize="12"
                           FontAttributes="Bold"
                           IsVisible="False"/>

                    <Label x:Name="CreatedAtLabel"
                           FontSize="12"
                           TextColor="#D8BFD8"/>
                </StackLayout>
            </Grid>
        </Border>

        <!-- Refresh button (visible on empty state) -->
        <Button x:Name="RefreshButton" Text="⟳" WidthRequest="44" HeightRequest="44" CornerRadius="22" BackgroundColor="#AA000000" TextColor="White" FontAttributes="Bold" FontSize="18" Clicked="OnRefreshClicked" HorizontalOptions="End" VerticalOptions="Start" Margin="16" IsVisible="False" />

        <!-- X BUTTON -->
        <!-- Circular 'x' button overlay to cycle events (bottom-left to mirror heart) -->
        <Button x:Name="CycleEventButton"
                Text="x"
                WidthRequest="44"
                HeightRequest="44"
                CornerRadius="22"
                BackgroundColor="#AA000000"
                TextColor="White"
                FontAttributes="Bold"
                FontSize="18"
                Clicked="OnCycleEventClicked"
                HorizontalOptions="Start"
                VerticalOptions="End"
                Margin="16"/>

        <!-- FAVORITE BUTTON -->
        <Button x:Name="FavoriteButton"
                Text="♥"
                WidthRequest="50"
                HeightRequest="50"
                CornerRadius="25"
                BackgroundColor="#AA00AA00"
                TextColor="White"
                Clicked="OnFavoriteClicked"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="16"/>

        <!-- TEST NOTIFICATION BUTTON -->
        <Button x:Name="TestNotificationButton"
                Text="🔔"
                WidthRequest="50"
                HeightRequest="50"
                CornerRadius="25"
                BackgroundColor="#AA9370DB"
                TextColor="White"
                Clicked="OnTestNotificationClicked"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="16,16,80,16"/>

    </Grid>

</ContentPage>